{
  "name": "gemini-prediction-markets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-healing local order book for Gemini prediction markets, with live integrity checks and fault injection.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"tsx watch server/src/index.ts\" \"vite\"",
    "dev:mock": "concurrently -n server,web -c blue,magenta \"tsx watch server/src/index.ts --mock\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "start:mock": "tsx server/src/index.ts --mock",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "discover": "tsx scripts/discover.ts",
    "record": "tsx scripts/record.ts",
    "rewards": "tsx scripts/rewards.ts"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
